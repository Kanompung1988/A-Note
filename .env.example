# Copy to .env.local and fill in. Never commit real values.

# Meta Model API key (https://dev.meta.ai). Every AI call in the app uses it.
META_API_KEY=
# Optional override, defaults to https://api.meta.ai/v1
# META_API_BASE_URL=

# Optional: Supabase for classes, asks and files (run supabase/migrations first).
# Without these the app keeps everything in a JSON file under .data/, which is fine locally.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Only for offline brand-asset scripts (logo, illustrations). The app never reads it.
OPEN_AI_API_KEY=
